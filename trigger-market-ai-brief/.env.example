# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# Every key here must ALSO be added to the Trigger.dev dashboard before
# deploying: cloud.trigger.dev -> your project -> Environment Variables.
# A key that exists locally but not there is the most common production failure.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ───────────────────────────────────────────────────────────────────

# Anthropic API key. Used by both automations.
# Get it from: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Trigger.dev secret key for the target environment ("tr_prod_" / "tr_dev_").
# Used by the SDK to trigger tasks from outside a run. The local dev server does
# NOT use this — `npx trigger.dev@latest dev` authenticates via `login`.
# Get it from: cloud.trigger.dev -> project -> API Keys
TRIGGER_SECRET_KEY=

# ── Daily AI News Digest -> Notion ───────────────────────────────────────────

# Notion internal integration token. Starts with "ntn_".
# Get it from: https://www.notion.so/my-integrations -> New integration
# After creating it, open the target database -> ... -> Connections -> add the
# integration, or every write will fail with "object not found".
NOTION_API_KEY=

# The 32-character ID in your Notion database URL:
# notion.so/<workspace>/THIS_PART?v=...
NOTION_DATABASE_ID=

# Resolved by running the "setup-check" task, which logs the value.
NOTION_DATA_SOURCE_ID=

# ── Market + AI Brief -> email ───────────────────────────────────────────────

# Resend API key, used to send the brief. Starts with "re_".
# Get it from: https://resend.com/api-keys  (free tier: 3,000 emails/month)
RESEND_API_KEY=

# Where the brief is delivered.
BRIEF_RECIPIENT_EMAIL=

# Sender address. "onboarding@resend.dev" is Resend's shared sender: it needs no
# domain verification, but can ONLY deliver to the address you signed up with.
# Swap in your own verified domain to send anywhere else.
BRIEF_FROM_EMAIL=onboarding@resend.dev
